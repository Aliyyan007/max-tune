# --- Core Qobuz API ---
QOBUZ_API_BASE=https://www.qobuz.com/api.json/0.2/
QOBUZ_APP_ID=
QOBUZ_SECRET=
# JSON array of account auth tokens, e.g. ["token1","token2"]
QOBUZ_AUTH_TOKENS=[]

NEXT_PUBLIC_APPLICATION_NAME=Qobuz-DL
NEXT_PUBLIC_GITHUB=https://github.com/QobuzDL/Qobuz-DL

# Required for the admin panel. There is no default password in production.
ADMIN_PASSWORD=

# --- Provider credentials (server-side; admin token pool can also manage these) ---
DEEZER_ARL=
# Tidal public metadata uses OAuth client credentials. Register a Tidal developer
# app for production; if unset, the compatibility device client is used for catalog-only tokens.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
# Tidal user bearer JWT is still required for playback entitlement. It lasts about
# a week; refresh token enables server-side renewal through the device-link flow.
TIDAL_ACCESS_TOKEN=
TIDAL_REFRESH_TOKEN=
# Spotify metadata fallback credentials. Full audio requires the OAuth/native
# session created through Admin → Connect Spotify.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_SESSION_JSON=
# Amazon Music session/token and Widevine device material for entitled accounts.
AMAZON_MUSIC_TOKEN=
AMAZON_SESSION_JSON=
AMAZON_DEVICE_WVD_B64=
# Apple full audio requires a media user token for an active Apple Music
# subscription plus a reachable wrapper-lite. Preview-only/free accounts fail honestly.
APPLE_MEDIA_USER_TOKEN=
# Comma-separated wrapper-lite endpoints are supported for multiple storefronts.
APPLE_WRAPPER_URL=

# Leave empty unless you know what you are doing.
CORS_PROXY=
SOCKS5_PROXY=

# --- Production queue mode ---
# When these are set, downloads/album zips are durable jobs processed by worker.mjs.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
# Strong random secret used to AES-GCM encrypt job payloads/results and shared
# credential-pool values in Redis. Required for production hygiene.
JOB_PAYLOAD_ENCRYPTION_KEY=
# Optional bearer token for /api/metrics.
METRICS_TOKEN=

# Worker process settings.
WORKER_CAPS=generic,apple
WORKER_POLL_MS=2500
WORKER_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
JOB_LEASE_MS=120000
# Render provisioning uses .venv-worker; Docker uses /app/.venv-worker.
NATIVE_PYTHON=

# --- Artifact store / cache (required in production queue mode) ---
# Cloudflare R2: dash.cloudflare.com → R2 → bucket → Manage R2 API Tokens.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# ~9GB LRU budget; Cloudflare's free tier is 10GB.
R2_CACHE_MAX_BYTES=9663676416
# Development-only escape hatch for Redis-inline results. Never use in production.
ALLOW_INLINE_RESULTS=0
# Legacy direct-stream endpoint (development compatibility). Disabled in production
# unless explicitly enabled because it performs provider work in the web process.
ENABLE_LEGACY_STREAM_AUDIO=0
# Production ignores request-supplied Apple wrapper URLs unless explicitly enabled;
# otherwise they are a blind-SSRF risk. Prefer APPLE_WRAPPER_URL/admin settings.
ALLOW_USER_APPLE_WRAPPER=0

# Bounded in-process production pipelines (web local mode and zip prefetch).
MAX_PARALLEL_DOWNLOADS=4
