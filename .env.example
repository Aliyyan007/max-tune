QOBUZ_API_BASE = https://www.qobuz.com/api.json/0.2/
QOBUZ_APP_ID = 
QOBUZ_SECRET = 
QOBUZ_AUTH_TOKENS = []

NEXT_PUBLIC_APPLICATION_NAME = Qobuz-DL
NEXT_PUBLIC_GITHUB = https://github.com/QobuzDL/Qobuz-DL

# Admin panel password — double-click the small dot in the bottom-right corner
ADMIN_PASSWORD = 

# Per-platform credentials (managed server-side via the admin panel / env)
DEEZER_ARL = 
# Tidal: Bearer JWT lasts ~7d. For auto-refresh, grab the OAuth refresh token too
# (listen.tidal.com DevTools → Application → Local Storage → oauth entry's refresh_token)
TIDAL_ACCESS_TOKEN = 
TIDAL_REFRESH_TOKEN = 
# Spotify metadata: developer app creds (developer.spotify.com — app owner needs Premium for full Web API access)
SPOTIFY_CLIENT_ID = 
SPOTIFY_CLIENT_SECRET = 
# Spotify audio: connect an account via the admin panel → Connect Spotify (OAuth link flow)

# Amazon Music Unlimited session JWT (from amz.dezalty.com)
AMAZON_MUSIC_TOKEN = 

# Apple: media-user-token from a logged-in music.apple.com premium session
# (DevTools → Network → amp-api.music.apple.com request → Media-User-Token header)
APPLE_MEDIA_USER_TOKEN = 
# Apple: where wrapper-lite runs (empty = default http://127.0.0.1:12340)
# boot it once with: tools\wrapper\wrapper-lite-qemu.exe --login user:pass  — then plain run
APPLE_WRAPPER_URL = 

#Leave these empty unless you know what you're doing
CORS_PROXY = 
SOCKS5_PROXY = 

# --- Queue worker mode (optional; in-process when unset) ---
# Upstash Redis (upstash.com → create database → REST credentials)
UPSTASH_REDIS_URL = 
UPSTASH_REDIS_TOKEN = 
# Worker: which queues to poll — generic | generic,apple (apple needs APPLE_WRAPPER_URL)
# WORKER_CAPS = generic,apple
# WORKER_POLL_MS = 2500

# --- Download cache: Cloudflare R2 (optional; repeat downloads served from cache) ---
# dash.cloudflare.com → R2 → bucket + "Manage R2 API Tokens"
R2_ENDPOINT = 
R2_BUCKET = 
R2_ACCESS_KEY_ID = 
R2_SECRET_ACCESS_KEY = 
# R2_CACHE_MAX_BYTES = 9663676416  # ~9GB LRU budget (free tier is 10GB)
